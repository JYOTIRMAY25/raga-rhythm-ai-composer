# ==============================================================================
# RagaRhythm AI - Environment Configuration Example
# Copy this file to .env and provide your local credentials.
# NEVER commit real keys or secrets to version control.
# ==============================================================================

# Backend Server Configuration
PORT=8080
HOST=0.0.0.0

# Google Gemini API Key (Optional: for AI musicological explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8080
