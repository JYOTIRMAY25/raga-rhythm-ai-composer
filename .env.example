# ==============================================================================
# RagaRhythm AI - Production Environment Configuration Reference
# ==============================================================================
# Copy this file to .env for local overrides.
# NEVER commit credentials, real API keys, or secret tokens to version control.
# ==============================================================================

# Runtime Environment (development | production | testing | staging)
APP_ENV=development

# Server Network Configuration
HOST=0.0.0.0
PORT=8080

# Logging Verbosity (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
# Development supports comma-separated localhost URLs.
# In PRODUCTION (APP_ENV=production), wildcard '*' is strictly forbidden.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Audio Processing & Ingestion Bounds
MAX_UPLOAD_SIZE_MB=25.0

# Asynchronous Analysis Job Engine Configuration
JOB_MAX_WORKERS=4
JOB_QUEUE_CAPACITY=50
JOB_RETENTION_LIMIT=1000
JOB_RETENTION_TTL_SECONDS=3600

# Google Gemini API Integration (Optional: for AI musicological explanations)
# If omitted or invalid, the system gracefully falls back to deterministic rule-based explanations.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Client Configuration (Build-time for Vite production bundling)
VITE_API_BASE_URL=http://localhost:8080
